set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

set(OPENST133_MINGW_PREFIX x86_64-w64-mingw32)
set(CMAKE_C_COMPILER ${OPENST133_MINGW_PREFIX}-gcc)
set(CMAKE_RC_COMPILER ${OPENST133_MINGW_PREFIX}-windres)

set(CMAKE_FIND_ROOT_PATH "/usr/${OPENST133_MINGW_PREFIX}")
if(DEFINED ENV{OPENST133_LIBUSB_ROOT} AND NOT "$ENV{OPENST133_LIBUSB_ROOT}" STREQUAL "")
    list(APPEND CMAKE_FIND_ROOT_PATH "$ENV{OPENST133_LIBUSB_ROOT}")
endif()

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

# Match the Windows artifact name used by the native and Python interfaces.
set(CMAKE_SHARED_LIBRARY_PREFIX "")
